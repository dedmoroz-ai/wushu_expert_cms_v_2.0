# Не отправлять в образ секреты, дампы, мусор и локальные артефакты.
.git
.gitignore
# ВНИМАНИЕ: .env пока НЕ исключён. Сейчас часть настроек (APP_NAME, SESSION_*,
# CACHE_*, MAIL_* и т.д.) приходит в контейнер только из .env, скопированного в образ.
# Исключать .env можно лишь после переноса всех этих переменных в docker-compose.yml
# (environment / env_file: .env).
.env.*
!.env.example
*.sql
*.sql.gz
*.bak
*.backup
*.bak.*
*.orig
*.rej
*.log
node_modules
vendor
_server
storage/app/public/*
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php
.phpunit.cache
.phpunit.result.cache
.idea
.vscode
docker-compose*.yml
Caddyfile
